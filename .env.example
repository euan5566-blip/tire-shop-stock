# Neon PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate a random secret with at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public app origin. Set to the exact Vercel Preview URL for preview testing.
APP_URL=https://your-preview-domain.vercel.app
BETTER_AUTH_URL=https://your-preview-domain.vercel.app
